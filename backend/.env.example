# AIDEN API — copy to .env and fill in. Never commit .env.

ENVIRONMENT=development            # development | test | staging | production

# Local dev uses SQLite. Phase 3 (MySQL 8):
# DATABASE_URL=mysql+pymysql://aiden:CHANGE_ME@localhost:3306/aiden?charset=utf8mb4
DATABASE_URL=sqlite:///./aiden_dev.db

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Field-level encryption for journal / chats / notes. Comma-separate to rotate (first key encrypts).
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ Losing this key makes encrypted data unreadable — store it in a secrets manager and back it up.
DATA_ENCRYPTION_KEYS=CHANGE_ME

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
DEFAULT_TIMEZONE=Asia/Kolkata

# AI provider: mock (demo rules). Real LLM providers are added in Phase 5.
AI_PROVIDER=mock
